<?xml version="1.0" encoding="utf-8"?>
<!-- No plain-HTTP anywhere, and only the OS's built-in CAs are trusted, so a
     user-installed certificate cannot be used to intercept api.anthropic.com. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
